{
  "name": "allpaid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Bitcoin Cash address that pays a whole team: every payment is split to each member by a covenant.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "node scripts/compile-contract.mjs",
    "dev": "npm run compile && vite",
    "build": "npm run compile && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run compile && vitest run",
    "typecheck": "tsc -b",
    "build:keeper": "npm run compile && vite build --ssr keeper/cli.ts --outDir dist-keeper --emptyOutDir",
    "keeper": "npm run build:keeper && node dist-keeper/cli.js"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@fontsource/archivo": "5.1.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/nunito-sans": "5.1.1",
    "@wizardconnect/core": "0.2.10",
    "@wizardconnect/dapp": "0.2.7",
    "@wizardconnect/react": "0.2.6",
    "cashscript": "0.14.0",
    "gsap": "3.14.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "6.3.0",
    "cashc": "0.14.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "bin": {
    "allpaid-keeper": "dist-keeper/cli.js"
  }
}
